<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ========================================================= -->
    <!-- Project Information                                        -->
    <!-- ========================================================= -->
    <modelVersion>4.0.0</modelVersion>

    <groupId>in.javahome</groupId>
    <artifactId>myweb</artifactId>
    <version>8.8.4</version>
    <packaging>war</packaging>

    <name>Java Home Web Application</name>
    <description>Sample Java Web Application with Azure Artifacts Integration</description>
    <url>https://maven.apache.org</url>

    <!-- ========================================================= -->
    <!-- Global Properties                                          -->
    <!-- ========================================================= -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Java Compatibility -->
        <java.version>8</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <!-- Docker Settings -->
        <docker.image.prefix>kammana</docker.image.prefix>

        <!-- SonarQube -->
        <sonar.host.url>http://18.181.164.81:9000</sonar.host.url>
    </properties>

    <!-- ========================================================= -->
    <!-- Dependencies                                               -->
    <!-- ========================================================= -->
    <dependencies>

        <!-- Unit Testing -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ========================================================= -->
    <!-- Artifact Repositories                                      -->
    <!-- ========================================================= -->
    <repositories>
        <repository>
            <id>flm-feed</id>
            <name>Azure Artifacts Maven Feed</name>
            <url>
                https://pkgs.dev.azure.com/afsanabegummd00/MyFirstProject/_packaging/flm-feed/maven/v1
            </url>

            <releases>
                <enabled>true</enabled>
            </releases>

            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!-- ========================================================= -->
    <!-- Distribution Management                                    -->
    <!-- ========================================================= -->
    <distributionManagement>

        <!-- Release Repository -->
        <repository>
            <id>flm-feed</id>
            <name>Azure Release Repository</name>
            <url>
                https://pkgs.dev.azure.com/afsanabegummd00/MyFirstProject/_packaging/flm-feed/maven/v1
            </url>
        </repository>

        <!-- Snapshot Repository -->
        <snapshotRepository>
            <id>nexusRepo</id>
            <name>Nexus Snapshot Repository</name>
            <url>
                http://34.208.218.12:8081/repository/sample-snapshots/
            </url>
        </snapshotRepository>

    </distributionManagement>

    <!-- ========================================================= -->
    <!-- Build Configuration                                        -->
    <!-- ========================================================= -->
    <build>

        <finalName>myweb</finalName>

        <plugins>

            <!-- Resource Processing -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>

            <!-- Java Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>

                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>

            <!-- Unit Test Execution -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- WAR Packaging -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>

                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

        </plugins>

    </build>

</project>
